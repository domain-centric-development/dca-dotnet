<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The application `dotnet new web` writes: Program.cs of top-level statements and nothing else. The architecture
       tests run the whole catalog over it and expect every rule to pass, because the generated Program only starts
       the program. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Acme.Web</RootNamespace>
  </PropertyGroup>
</Project>
